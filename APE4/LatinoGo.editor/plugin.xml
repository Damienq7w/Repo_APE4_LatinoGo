<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>

<!--
-->

<plugin>

   <extension point="org.eclipse.ui.newWizards">
      <!-- @generated latino -->
      <category
            id="org.eclipse.emf.ecore.Wizard.category.ID"
            name="%_UI_Wizard_category"/>
      <wizard
            id="latino.presentation.LatinoModelWizardID"
            name="%_UI_LatinoModelWizard_label"
            class="latino.presentation.LatinoModelWizard"
            category="org.eclipse.emf.ecore.Wizard.category.ID"
            icon="icons/full/obj16/LatinoModelFile.gif">
         <description>%_UI_LatinoModelWizard_description</description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <!-- @generated latino -->
      <editor
            id="latino.presentation.LatinoEditorID"
            name="%_UI_LatinoEditor_label"
            icon="icons/full/obj16/LatinoModelFile.gif"
            extensions="latino"
            class="latino.presentation.LatinoEditor"
            contributorClass="latino.presentation.LatinoActionBarContributor">
      </editor>
   </extension>

</plugin>
