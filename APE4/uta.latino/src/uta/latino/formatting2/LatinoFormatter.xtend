import org.eclipse.xtext.formatting2.AbstractFormatter2
import org.eclipse.xtext.formatting2.IFormattableDocument

// Recorre las sentencias del programa, de cada si, de cada ciclo, de cada elegir y de cada funcion. Todavia no pone reglas de espacios ni sangria
class LatinoFormatter extends AbstractFormatter2 {

	def dispatch void format(Programa programa, extension IFormattableDocument document) {
		for (sentencia : programa.sentencias) {
			sentencia.format
