	}

	// Entra a cada caso y al bloque de otro
	def dispatch void format(Elegir elegir, extension IFormattableDocument document) {
		for (caso : elegir.casos) {
			for (sentencia : caso.sentencias) {
				sentencia.format
			}
		}
		for (sentencia : elegir.defecto) {
			sentencia.format
		}
	}

	// Entra al cuerpo de la funcion
	def dispatch void format(Funcion funcion, extension IFormattableDocument document) {
		for (sentencia : funcion.cuerpo) {
			sentencia.format
		}
	}

